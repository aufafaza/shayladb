<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>mdbms</groupId>
        <artifactId>mdbms-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mdbms-app</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-optimizer</artifactId>
        </dependency>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-concurrency</artifactId>
        </dependency>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-recovery</artifactId>
        </dependency>
        <dependency>
            <groupId>mdbms</groupId>
            <artifactId>mdbms-net</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>mdbms</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>mdbms.app.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
